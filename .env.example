# ==========================================
# PDHPSYCO - Environment Variables Configuration
# Pluak Daeng Hospital Mental Health System
# ==========================================

# Server Environment
NODE_ENV="development"
PORT=3000

# Application Base URL
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="pdhpsyco_production_super_secret_auth_key_replace_me_32chars!"
NEXTAUTH_SECRET="pdhpsyco_production_super_secret_auth_key_replace_me_32chars!"

# Database Connection (MySQL 8+)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@127.0.0.1:3306/pdhpsyco"

# PII Field AES-256-GCM Encryption Key (Must be 32 bytes/64 hex chars or 32 chars string)
ENCRYPTION_KEY="pdhpsyco_encryption_key_32_bytes_len_secure!"

# Seed Admin User (Used in prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@pdhpsyco.pluakdaenghospital.cloud"
SEED_ADMIN_PASSWORD="PdhAdminSecurePassword2026!"
SEED_ADMIN_NAME="Super Administrator"

# Integrations & Notification Channels
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
N8N_WEBHOOK_URL=""

# SMTP Email Notification Configuration (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@pdhpsyco.pluakdaenghospital.cloud"
